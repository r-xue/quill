# ── Quill Secrets ──────────────────────────────────────────────────────
#
# Copy this file to .env and fill in your tokens.
# This file should be git-ignored — never commit real secrets.
#
# All variables are prefixed with QUILL_ and map to Settings fields.
# See docs/configuration.md for the full 4-layer precedence explanation.

# ── GitHub ──────────────────────────────────────────────────────────────
# Optional for public repos, but recommended (60 req/hr → 5,000 req/hr)
QUILL_GITHUB_TOKEN=ghp_your_github_personal_access_token

# ── Jira ────────────────────────────────────────────────────────────────
QUILL_JIRA_TOKEN=your_jira_personal_access_token
